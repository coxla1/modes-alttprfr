---
import Mode from "../components/Mode.astro";

const {agreementId, modesData, categorySlug} = Astro.props;

const agreements = {
  0: "Toujours disponible",
  1: "Accord nécessaire en phase de groupes uniquement",
  2: "Accord nécessaire durant les deux phases",
};
---
<h3 class="card-title mt-2">{agreements[agreementId]}</h3>
<div class="accordion" id={"accordion-" + categorySlug + "-" + agreementId}>
  {modesData.map((mode) => {
    return <Mode
      frenchName={mode.french_name}
      englishName={mode.english_name}
      preset={mode.preset}
      description={mode.description}
      categorySlug={categorySlug}
      generatorSlug={mode.generator}
      agreement={agreementId}
    />
  })}
</div>
