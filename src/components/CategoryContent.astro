---
import Agreement from "../components/Agreement.astro";

const {categorySlug, modesData, defaultActive} = Astro.props;
---
<div
  class:list={["tab-pane fade", {"show active": defaultActive}]}
  id={categorySlug + "-tab-pane"}
  role="tabpanel"
  aria-labelledby={categorySlug + "-tab"}
  tabindex="0"
>
  {[0, 1, 2].map((id) => {
    if (modesData[id].length) return <Agreement agreementId={id} modesData={modesData[id]} categorySlug={categorySlug} />
  })}
</div>
