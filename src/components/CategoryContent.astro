---
import Agreement from "../components/Agreement.astro";

const {categorySlug, defaultActive = false} = Astro.props;
---
<div
  class:list={["tab-pane fade", {"show active": defaultActive}]}
  id={categorySlug + "-tab-pane"}
  role="tabpanel"
  aria-labelledby={categorySlug + "-tab"}
  tabindex="0"
>
  <Agreement agreementId={0} categorySlug={categorySlug} />
  <Agreement agreementId={1} categorySlug={categorySlug} />
  <Agreement agreementId={2} categorySlug={categorySlug} />
</div>
