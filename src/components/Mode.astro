---
import generatorsData from "../data/generators.json";

const {frenchName, englishName, preset, description, categorySlug, generatorSlug, agreement} = Astro.props;
---
<div class="accordion-item">
  <h2 class="accordion-header">
    <button
      class="accordion-button collapsed"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target={"#collapse-" + categorySlug + "-" + generatorSlug + "-" + preset}
      aria-expanded="false"
      aria-controls={"collapse-" + categorySlug + "-" + generatorSlug + "-" + preset}
    >
      {frenchName} ({englishName})
    </button>
  </h2>
  <div
    id={"collapse-" + categorySlug + "-" + generatorSlug + "-" + preset}
    class="accordion-collapse collapse"
    data-bs-parent={"#accordion-" + categorySlug + "-" + agreement}
  >
  <div
    class="accordion-body card-text"
      set:html={description +  "<br />" +
      "Commande Discord " + generatorsData[generatorSlug].name + " : " +
      "<kbd>" + generatorsData[generatorSlug].prefix + " preset:" + preset + "</kbd>" + "<br />" +
      "Commande Racetime.gg : " +
      "<kbd>" + generatorsData[generatorSlug].raceroom + preset + "</kbd>"
      }
  >
    </div>
  </div>
</div>
