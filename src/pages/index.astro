---
import Layout from '../layouts/Layout.astro';

import CategoryHeader from '../components/CategoryHeader.astro';
import CategoryContent from '../components/CategoryContent.astro';
---
<!-- TODO: for loop pour les cate -->
<!-- TODO: correspondance categorySlug et categoryName -->
<Layout>
  <h1>Modes</h1>
  <div class="card">
    <div class="card-header" id="category-tabs" role="tablist">
      <ul class="nav nav-tabs card-header-tabs">
        <CategoryHeader categoryName="Ouverte" categorySlug="OPN" defaultActive={true} />
        <CategoryHeader categoryName="Standard" categorySlug="STD" />
      </ul>
    </div>

    <div class="card-body tab-content" id="category-content">
      <CategoryContent categorySlug="OPN" defaultActive={true} />
      <CategoryContent categorySlug="STD" />
    </div>
  </div>
</Layout>
