---
import Layout from "../layouts/Layout.astro";

import CategoryHeader from "../components/CategoryHeader.astro";
import CategoryContent from "../components/CategoryContent.astro";

import categoriesData from "../data/categories.json";
import openData from "../data/opn.json";
import standardData from "../data/std.json";
import spoilerData from "../data/spl.json";

const modesData = {
  "OPN": openData,
  "STD": standardData,
  "SPL": spoilerData,
  "KEY": [[], [], [], []],
  "ENE": [[], [], [], []],
  "INV": [[], [], [], []],
};
---
<Layout pageTitle="Modes tournoi">
  <h1>Modes tournoi 9</h1>
  <div class="card">
    <div class="card-header" id="category-tabs" role="tablist">
      <ul class="nav nav-tabs card-header-tabs">
        {categoriesData.map((category) => {
          const defaultActive = category.slug === "OPN"
          return <CategoryHeader categoryName={category.name} categorySlug={category.slug} defaultActive={defaultActive} />
        })}
      </ul>
    </div>

    <div class="card-body tab-content" id="category-content">
      {categoriesData.map((category) => {
        const defaultActive = category.slug === "OPN"
        return <CategoryContent categorySlug={category.slug} modesData={modesData[category.slug]} defaultActive={defaultActive} />
      })}
    </div>
  </div>
</Layout>
